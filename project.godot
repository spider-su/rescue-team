; Engine configuration file.
; Godot 4.7.2 stable; open with the standard (non-C#) editor.
config_version=5

[application]

config/name="Rescue Team"
config/icon="res://assets/branding/app-icon.png"
boot_splash/image="res://assets/branding/boot-splash.png"
boot_splash/bg_color=Color(0.0980392, 0.309804, 0.388235, 1)
boot_splash/stretch_mode=1
boot_splash/minimum_display_time=0
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.070, 0.105, 1)
